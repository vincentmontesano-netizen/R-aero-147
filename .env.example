# ─── R-AERO Training Academy — environment variables ─────────────────────────
# Copy to `.env` (next to docker-compose.yml) and fill in. NEVER commit real secrets.

# Strong random secret signing the session cookies.
# If left empty in Docker, a stable one is auto-generated and persisted in the volume.
JWT_SECRET=

# Port exposed on the host (the app always listens on 3000 inside the container).
APP_PORT=3000

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Server-side secret key (sk_test_… in test mode, sk_live_… in production).
STRIPE_SECRET_KEY=
# Public key (pk_test_… / pk_live_…). Optional — the hosted Checkout flow does not need it client-side.
VITE_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_…) from the Stripe dashboard endpoint → /api/stripe/webhook.
# Optional: payment is also confirmed on return, but a webhook is recommended in production.
STRIPE_WEBHOOK_SECRET=
# B2B subscription ("conformité-as-a-subscription") — recurring Price IDs (price_…).
# Without these, the subscription flow runs in DEMO mode (access activated instantly).
STRIPE_PRICE_STANDARD_SEAT=
STRIPE_PRICE_ALL_INCLUSIVE=
STRIPE_PORTAL_CONFIGURATION_ID=

# ─── AI e-learning maker (all optional) ──────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ─── Email / SMTP (optional) ─────────────────────────────────────────────────
# Order confirmations, recyclage-expiry reminders, quote/ticket replies, broadcasts.
# Can also be configured at runtime from Admin → Settings (stored in DB, overrides these).
# If unset, emails are logged (not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=R-AERO Academy <no-reply@r-aero.academy>
# Address that receives event alerts (new quote, new ticket, client reply, new sign-up).
# Defaults to SMTP_USER when unset.
ADMIN_NOTIFY_EMAIL=contact@r-aero-academy.com

# ─── External database (optional) ─────────────────────────────────────────────
# Leave empty to use the PostgreSQL embedded in the container. Set to use Supabase/managed PG.
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Private live classrooms (JaaS). Public meeting fallback is disabled.
# Upload the matching RSA public key in JaaS; keep the private key server-side.
JAAS_APP_ID=
# Full key ID: <JAAS_APP_ID>/<key-id>
JAAS_API_KEY_ID=
# PEM private RSA key (2048 bits minimum); escaped \n sequences accepted.
JAAS_PRIVATE_KEY=

# Explicit reverse proxy IP/CIDR allowlist (blank trusts no forwarded headers).
TRUST_PROXY=
