{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@mobile/*": ["src/*"],
      "@shared/*": ["../shared/*"],
      "@/*": ["../client/src/*"]
    }
  },
  "include": ["app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "app.config.ts", "expo-env.d.ts", ".expo/types/**/*.ts", "../server/bidi-js.d.ts"]
}
