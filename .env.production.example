# ============================================================================
#  R-AERO Training Academy — PRODUCTION environment (Docker Compose / Hostinger VPS)
#
#  Usage :
#    cp .env.production.example .env
#    nano .env            # remplir les valeurs ci-dessous
#    docker compose up -d --build
#
#  docker-compose lit automatiquement le fichier .env de ce dossier.
#  Ne JAMAIS committer le fichier .env rempli (il est déjà gitignoré).
# ============================================================================

# ── Port public exposé sur le VPS (le reverse-proxy Hostinger pointe dessus) ──
APP_PORT=3000

# ── Compte ADMIN (première installation uniquement) ──────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Stripe (paiements réels) ─────────────────────────────────────────────────
#   Tableau de bord Stripe → Developers → API keys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
#   Stripe → Developers → Webhooks (endpoint: https://VOTRE-DOMAINE/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# ── IA — Mistral (texte + image + narration vocale) ──────────────────────────
MISTRAL_API_KEY=
# (optionnel) autres fournisseurs IA :
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Email (envoi SMTP + réception IMAP) — boîte Hostinger ────────────────────
#   Laisser vide = emails seulement journalisés (pas d'envoi réel).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
IMAP_HOST=
IMAP_PORT=993

# ── Origine publique (liens dans les emails : reset mot de passe, etc.) ──────
APP_ORIGIN=

# ── Secret de session ────────────────────────────────────────────────────────
#   Laisser VIDE = généré automatiquement et persisté dans le volume (recommandé).
#   Ou imposer le vôtre : openssl rand -hex 32
JWT_SECRET=

# Private live classrooms (JaaS). Public meeting fallback is disabled.
# Upload the matching RSA public key in JaaS; keep the private key server-side.
JAAS_APP_ID=
# Full key ID: <JAAS_APP_ID>/<key-id>
JAAS_API_KEY_ID=
# PEM private RSA key (2048 bits minimum); escaped \n sequences accepted.
JAAS_PRIVATE_KEY=

# Exact validated registry image for docker-compose.prod.yml (image@sha256:digest).
RAERO_IMAGE=
# Canonical HTTPS origin for checkout and portal returns.
PUBLIC_APP_URL=
STRIPE_PRICE_STANDARD_SEAT=
STRIPE_PRICE_ALL_INCLUSIVE=
SEED_DEMO_DATA=false
# Comma-separated IP/CIDR addresses of your actual reverse proxies; blank trusts none.
# Do not use true, hop counts, or all-address networks. The proxy must replace forwarded headers.
TRUST_PROXY=

# Per-account AI requests in a rolling hour (0 disables a category; max 1000).
AI_TEXT_REQUESTS_PER_HOUR=30
AI_IMAGE_REQUESTS_PER_HOUR=10
AI_SPEECH_REQUESTS_PER_HOUR=20

# Optional Google video generation: select an enabled Veo model explicitly.
GEMINI_VIDEO_MODEL=
AI_VIDEO_REQUESTS_PER_HOUR=2

# Required before issuing new invoices. JSON fields documented in docs/invoice-archive.md.
INVOICE_ISSUER_JSON=
